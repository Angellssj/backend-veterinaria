# Configuracion del despliegue. deploy/ec2-deploy.sh crea .env con secretos aleatorios;
# para hacerlo a mano: cp .env.example .env y completa los valores vacios.
HTTP_PORT=80
SPRING_PORT=8080
# 127.0.0.1 = API solo accesible por Nginx (/api). 0.0.0.0 = expone el 8080 a internet.
SPRING_BIND=127.0.0.1
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
APP_ADMIN_EMAIL=admin@sanmarcos.cl
APP_ADMIN_PASSWORD=
APP_SEED_DEMO_CLIENT=false
# Opcional: origenes extra permitidos por CORS (separados por coma).
CORS_ALLOWED_ORIGINS=
