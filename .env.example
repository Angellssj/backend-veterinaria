# Configuracion del despliegue. Completa estos valores antes de iniciar Compose.
PUBLIC_IP=
SPRING_PORT=8080
HTTP_PORT=80
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
APP_ADMIN_EMAIL=admin@sanmarcos.cl
APP_ADMIN_PASSWORD=
APP_SEED_DEMO_CLIENT=false
# Opcional. Si queda vacio, Compose permite el origen http://${PUBLIC_IP}.
# Configuralo como http://${PUBLIC_IP}:${HTTP_PORT} cuando HTTP_PORT no sea 80.
CORS_ALLOWED_ORIGINS=
