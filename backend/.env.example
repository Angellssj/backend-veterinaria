# Configuracion del despliegue. Completa estos valores antes de iniciar Compose.
# En la EC2, deploy/ec2-deploy.sh crea este archivo con secretos aleatorios.
HTTP_PORT=80
SPRING_PORT=8080
# 127.0.0.1 = API solo accesible por Nginx (/api). 0.0.0.0 = expone el 8080 a internet.
SPRING_BIND=127.0.0.1
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
APP_ADMIN_EMAIL=admin@sanmarcos.cl
APP_ADMIN_PASSWORD=
APP_SEED_DEMO_CLIENT=false
# Opcional: origenes extra permitidos por CORS (separados por coma).
CORS_ALLOWED_ORIGINS=
VITE_API_URL=/api/v1
# Memoria de Java dentro del contenedor. Ajustable según tu instancia.
JAVA_TOOL_OPTIONS=-Xms64m -Xmx384m
